# ReplayChemVariant: two chemistry variants of the same histories share their
# physical stage (ADR 0015). Replays every history of the phase-space file
# PHSP with the chemistry on and the default end time (1 us):
#   a  no dissolved O2, 1 thread
#   b  /phsp/chem/o2 21 %, 2 threads
#   c  no dissolved O2, the range split into two runs in one process, 1 thread
# and checks
#   - Histories.csv of b and c against a: identical rows, every column
#     (stage-2 deposit, pre-chemical counts, chemistry end time = 1000 ns),
#     although b has another O2 concentration and another thread count, and
#     c splits the range;
#   - some pre-chemical products, none outside the box, no molecule killed
#     outside water (the 2 um water margin holds every molecule up to 1 us),
#     and the margin in Manifest.json;
#   - Species.csv: less e_aq at 1 us summed over the histories with O2 than
#     without (e_aq + O2 -> O2-, 1.74e10 /M/s x 0.273 mM: a 210 ns lifetime).
#   -DREPLAY=<phsp-replay> -DDUMP=<phsp-dump> -DPHSP=<file.phsp> -DOUTPUT_DIR=<dir> -DBASE_SEED=<s>
foreach(var REPLAY DUMP PHSP OUTPUT_DIR BASE_SEED)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "RunReplayChemVariant.cmake: ${var} is not set")
  endif()
endforeach()
include(${CMAKE_CURRENT_LIST_DIR}/ReplayTestUtilities.cmake)

file(REMOVE_RECURSE "${OUTPUT_DIR}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")

phsp_histories_written("${PHSP}" historyCount)
if(historyCount LESS 2)
  message(FATAL_ERROR "${PHSP} holds ${historyCount} histories; the comparison needs at least 2")
endif()
phsp_write_replay_macro("${OUTPUT_DIR}/no-o2.mac" "${PHSP}" ${BASE_SEED} "" "0 ${historyCount}")
phsp_write_replay_macro("${OUTPUT_DIR}/o2.mac" "${PHSP}" ${BASE_SEED} "/phsp/chem/o2 21 %" "0 ${historyCount}")
math(EXPR splitAt "${historyCount} / 2")
math(EXPR secondCount "${historyCount} - ${splitAt}")
phsp_write_replay_macro("${OUTPUT_DIR}/split.mac" "${PHSP}" ${BASE_SEED} "" "0 ${splitAt}" "${splitAt} ${secondCount}")
phsp_run_replay(a "${OUTPUT_DIR}/no-o2.mac" 1 done_a)
phsp_run_replay(b "${OUTPUT_DIR}/o2.mac" 2 done_b)
phsp_run_replay(c "${OUTPUT_DIR}/split.mac" 1 done_c)
message(STATUS "a: ${done_a}")
message(STATUS "b: ${done_b}")
message(STATUS "c: ${done_c}")

foreach(run a b c)
  phsp_done_value("${done_${run}}" chemistry chemistry)
  phsp_done_value("${done_${run}}" endTimeNs endTime)
  phsp_done_value("${done_${run}}" preChemOutsideBox outside)
  phsp_done_value("${done_${run}}" moleculesKilledOutsideWater killed)
  if(NOT chemistry STREQUAL "on" OR NOT endTime STREQUAL "1000")
    message(FATAL_ERROR "run ${run}: chemistry=${chemistry} endTimeNs=${endTime}, expected on and 1000 (the default 1 us)")
  endif()
  if(NOT outside EQUAL 0)
    message(FATAL_ERROR "run ${run}: ${outside} pre-chemical products outside the box, expected 0")
  endif()
  if(NOT killed EQUAL 0)
    message(FATAL_ERROR "run ${run}: ${killed} molecules killed outside water, expected 0 with the 2 um margin at 1 us")
  endif()
  file(READ "${OUTPUT_DIR}/${run}/Manifest.json" manifest)
  if(NOT manifest MATCHES "\"chemMargin_nm\": 2000" OR NOT manifest MATCHES "\"moleculesKilledOutsideWater\": 0")
    message(FATAL_ERROR "run ${run}: Manifest.json does not record chemMargin_nm 2000 and moleculesKilledOutsideWater 0")
  endif()
endforeach()
file(READ "${OUTPUT_DIR}/b/Manifest.json" manifestB)
if(NOT manifestB MATCHES "\"o2\": \"21 %\"" OR NOT manifestB MATCHES "\"o2_M\": 0.000273")
  message(FATAL_ERROR "run b: Manifest.json does not record /phsp/chem/o2 21 % (0.000273 M)")
endif()

# Histories.csv: same header and rows (c against a first, then b against a).
file(STRINGS "${OUTPUT_DIR}/a/Histories.csv" rowsA)
file(STRINGS "${OUTPUT_DIR}/c/Histories.csv" rowsC)
if(NOT rowsC STREQUAL rowsA)
  list(LENGTH rowsC linesC)
  message(FATAL_ERROR "run c (range split into 0..${splitAt} and ${splitAt}..) wrote another Histories.csv than "
                      "run a (${linesC} lines)")
endif()
message(STATUS "Histories.csv, c (range split into two runs) vs a: identical")
file(STRINGS "${OUTPUT_DIR}/b/Histories.csv" rowsB)
list(LENGTH rowsA linesA)
list(LENGTH rowsB linesB)
math(EXPR expectedLines "${historyCount} + 1")
if(NOT linesA EQUAL expectedLines OR NOT linesB EQUAL expectedLines)
  message(FATAL_ERROR "Histories.csv: ${linesA} (a) and ${linesB} (b) lines, expected ${expectedLines}")
endif()
list(GET rowsA 0 headerA)
list(GET rowsB 0 headerB)
if(NOT headerA STREQUAL headerB OR NOT headerA MATCHES ",preChemIonisedH2O,preChemExcitedH2O,preChemAttachedH2O,preChemEaq,chemistryEndTimeNs$")
  message(FATAL_ERROR "Histories.csv headers:\n  a: ${headerA}\n  b: ${headerB}")
endif()
set(differing 0)
set(preChemTotal 0)
math(EXPR last "${linesA} - 1")
foreach(i RANGE 1 ${last})
  list(GET rowsA ${i} rowA)
  list(GET rowsB ${i} rowB)
  if(NOT rowA STREQUAL rowB)
    math(EXPR differing "${differing} + 1")
    if(differing LESS_EQUAL 3)
      message(STATUS "row ${i}:\n  a (no O2):  ${rowA}\n  b (21 % O2): ${rowB}")
    endif()
  endif()
  string(REPLACE "," ";" fields "${rowA}")
  foreach(column 10 11 12 13)
    list(GET fields ${column} value)
    math(EXPR preChemTotal "${preChemTotal} + ${value}")
  endforeach()
endforeach()
message(STATUS "Histories.csv, a (no O2, 1 thread) vs b (21 % O2, 2 threads): ${differing} differing rows of "
               "${historyCount} (stage-2 deposit, pre-chemical counts, end time)")
message(STATUS "pre-chemical products over the ${historyCount} histories: ${preChemTotal}")
if(NOT differing EQUAL 0)
  message(FATAL_ERROR "the O2 variant changed the physical stage of ${differing} histories")
endif()
if(preChemTotal EQUAL 0)
  message(FATAL_ERROR "no pre-chemical product in any history: the chemistry did not see the physics")
endif()

# Species.csv: e_aq (e_aq^-1) and O2- (O_2^-1) at the end time (1000 ns), summed
# over the histories (species names are G4MolecularConfiguration::GetName()).
function(sum_species run species outVar)
  set(csv "${OUTPUT_DIR}/${run}/Species.csv")
  if(NOT EXISTS "${csv}")
    message(FATAL_ERROR "run ${run} wrote no ${csv}")
  endif()
  file(STRINGS "${csv}" lines REGEX "^[0-9]+,1000,${species},")
  set(total 0)
  set(histories 0)
  foreach(line IN LISTS lines)
    string(REPLACE "," ";" fields "${line}")
    list(GET fields 3 count)
    math(EXPR total "${total} + ${count}")
    math(EXPR histories "${histories} + 1")
  endforeach()
  set(${outVar} ${total} PARENT_SCOPE)
  set(${outVar}_histories ${histories} PARENT_SCOPE)
endfunction()
sum_species(a "e_aq\\^-1" eaqA)
sum_species(b "e_aq\\^-1" eaqB)
sum_species(a "O_2\\^-1" o2mA)
sum_species(b "O_2\\^-1" o2mB)
message(STATUS "e_aq at 1 us, summed over the histories: ${eaqA} without O2 (${eaqA_histories} histories with e_aq rows), "
               "${eaqB} with 21 % O2 (${eaqB_histories})")
message(STATUS "O2- at 1 us, summed over the histories: ${o2mA} without O2, ${o2mB} with 21 % O2")
if(eaqA EQUAL 0)
  message(FATAL_ERROR "no e_aq left at 1 us without O2: nothing to compare")
endif()
if(NOT eaqB LESS eaqA)
  message(FATAL_ERROR "e_aq at 1 us is not lower with 21 % O2 (${eaqB}) than without (${eaqA})")
endif()
message(STATUS "ReplayChemVariant: 0 differing physics/pre-chemical rows; e_aq at 1 us ${eaqB} (21 % O2) < ${eaqA} (no O2)")
