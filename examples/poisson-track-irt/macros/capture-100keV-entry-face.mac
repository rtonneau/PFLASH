# capture-100keV-entry-face.mac: 100 keV electrons crossing a 5 um box.
# Each primary starts at a random point of the -z face (z = -halfSide + 1 nm) and moves
# along +z, so every packet is a track segment of a broad parallel beam.
# Commands are applied one line at a time; do not put /run/beamOn here.
/control/verbose 0
/run/verbose 0
/tracking/verbose 0
/scheduler/verbose 0

# Capture volume (PreInit): a water box, half side 2.5 um.
/ptirt/capture/halfSide 2.5 um
# Entry-face placement (overrides /gun/position and /gun/direction).
/ptirt/capture/entryFace true

/run/initialize

/gun/particle e-
/gun/energy 100 keV
