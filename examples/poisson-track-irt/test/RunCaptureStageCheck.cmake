# CaptureAfterStartupContacts (stock) / CaptureAtChemistryStart (patched):
# the captured stage, run twice, and the capture.json fields that describe it.
#   -DCAPTURE=<exe> -DMACRO=<file> -DOUTPUT_DIR=<dir> -DFIRST_SEED=<s> -DCOUNT=<n>
#   -DEXPECT_BUILD=stock|patched -DEXPECT_STAGE=afterStartupContacts|chemistryStart
#   [-DEXPECT_MODULES=ON]   also require loadedGeant4Modules to be listed (Windows)
#
# Checked for both builds:
#   * two runs with the same seeds write byte-identical packets, library.csv and
#     capture.json (SHA256);
#   * capture.json names the build and, for every packet, the stage and two
#     16-digit digests; the packet file holds nothing but 1 ps molecules;
#   * product groups are dense 1..G (and all 0 where no reaction ran).
# Stock only: startupZeroSteps >= 1, chemistrySeed = 2147483648 - physicsSeed, the
# captured molecules differ from the molecules waiting at chemistry start in at
# least one packet, and some molecule carries a product group.
# Patched only: the two digests are equal, no stock-only field is written, and no
# molecule carries a product group.
foreach(var CAPTURE MACRO OUTPUT_DIR FIRST_SEED COUNT EXPECT_BUILD EXPECT_STAGE)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "RunCaptureStageCheck.cmake: ${var} is not set")
  endif()
endforeach()

file(REMOVE_RECURSE "${OUTPUT_DIR}")
foreach(name run-a run-b)
  execute_process(
    COMMAND "${CAPTURE}" --macro "${MACRO}" --output "${OUTPUT_DIR}/${name}" --count ${COUNT} --first-seed ${FIRST_SEED}
    RESULT_VARIABLE result
    OUTPUT_VARIABLE out
    ERROR_VARIABLE err)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "capture ${name} failed (${result}):\n${err}\n${out}")
  endif()
endforeach()

# ---- Repeat run: byte-identical output ----------------------------------------
math(EXPR lastIndex "${COUNT} - 1")
set(files library.csv capture.json)
foreach(i RANGE ${lastIndex})
  string(LENGTH "${i}" digits)
  set(index "${i}")
  while(digits LESS 5)
    set(index "0${index}")
    string(LENGTH "${index}" digits)
  endwhile()
  list(APPEND files "packet-${index}.txt")
endforeach()
foreach(file IN LISTS files)
  file(SHA256 "${OUTPUT_DIR}/run-a/${file}" a)
  file(SHA256 "${OUTPUT_DIR}/run-b/${file}" b)
  message(STATUS "${file}: ${a}")
  if(NOT a STREQUAL b)
    message(FATAL_ERROR "a repeated capture with the same seeds wrote a different ${file}: ${a} / ${b}")
  endif()
endforeach()

# ---- capture.json ---------------------------------------------------------------
file(READ "${OUTPUT_DIR}/run-a/capture.json" json)
string(JSON buildMode GET "${json}" buildMode)
if(NOT buildMode STREQUAL EXPECT_BUILD)
  message(FATAL_ERROR "capture.json buildMode is '${buildMode}', expected '${EXPECT_BUILD}'")
endif()
string(JSON moduleCount LENGTH "${json}" loadedGeant4Modules)
if(EXPECT_MODULES AND moduleCount EQUAL 0)
  message(FATAL_ERROR "capture.json lists no loaded Geant4 module")
endif()
string(JSON packetCount LENGTH "${json}" packets)
if(NOT packetCount EQUAL COUNT)
  message(FATAL_ERROR "capture.json lists ${packetCount} packets, expected ${COUNT}")
endif()

set(anyDigestDiffers OFF)
set(anyProductGroup OFF)
foreach(i RANGE ${lastIndex})
  string(JSON stage GET "${json}" packets ${i} captureStage)
  if(NOT stage STREQUAL EXPECT_STAGE)
    message(FATAL_ERROR "packet ${i}: captureStage '${stage}', expected '${EXPECT_STAGE}'")
  endif()
  string(JSON startDigest GET "${json}" packets ${i} chemistryStartDigest)
  string(JSON capturedDigest GET "${json}" packets ${i} capturedDigest)
  foreach(digest "${startDigest}" "${capturedDigest}")
    if(NOT digest MATCHES "^[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]$")
      message(FATAL_ERROR "packet ${i}: '${digest}' is not 16 lowercase hexadecimal digits")
    endif()
  endforeach()
  if(NOT startDigest STREQUAL capturedDigest)
    set(anyDigestDiffers ON)
  endif()
  string(JSON seed GET "${json}" packets ${i} physicsSeed)
  message(STATUS "packet ${i}: seed ${seed} start ${startDigest} captured ${capturedDigest}")

  string(JSON seedType ERROR_VARIABLE seedError TYPE "${json}" packets ${i} chemistrySeed)
  string(JSON zeroSteps ERROR_VARIABLE zeroError GET "${json}" packets ${i} startupZeroSteps)
  string(JSON reactions ERROR_VARIABLE reactionError GET "${json}" packets ${i} startupReactions)
  if(EXPECT_BUILD STREQUAL "stock")
    if(seedError OR zeroError OR reactionError)
      message(FATAL_ERROR "packet ${i}: a stock-only field is missing from capture.json")
    endif()
    string(JSON chemistrySeed GET "${json}" packets ${i} chemistrySeed)
    math(EXPR expectedSeed "2147483648 - ${seed}")
    if(NOT chemistrySeed STREQUAL expectedSeed)
      message(FATAL_ERROR "packet ${i}: chemistrySeed ${chemistrySeed}, expected 2147483648 - ${seed} = ${expectedSeed}")
    endif()
    if(zeroSteps LESS 1)
      message(FATAL_ERROR "packet ${i}: startupZeroSteps ${zeroSteps}, expected at least 1")
    endif()
    message(STATUS "packet ${i}: chemistrySeed ${chemistrySeed}, ${zeroSteps} zero-length steps, ${reactions} start-up reactions")
  else()
    if(NOT (seedError AND zeroError AND reactionError))
      message(FATAL_ERROR "packet ${i}: capture.json has a stock-only field in a patched build")
    endif()
    if(NOT startDigest STREQUAL capturedDigest)
      message(FATAL_ERROR "packet ${i}: capture at chemistry start must have equal digests (${startDigest} / ${capturedDigest})")
    endif()
  endif()
endforeach()

if(EXPECT_BUILD STREQUAL "stock" AND NOT anyDigestDiffers)
  message(FATAL_ERROR "no packet differs from the chemistry-start molecules: the start-up contacts changed nothing")
endif()

# ---- Packet files ---------------------------------------------------------------
# molecule <name> <charge> <status> <productGroup> <nOcc> <occ...> <x y z> <dx dy dz> <global time> ...
foreach(i RANGE ${lastIndex})
  string(LENGTH "${i}" digits)
  set(index "${i}")
  while(digits LESS 5)
    set(index "0${index}")
    string(LENGTH "${index}" digits)
  endwhile()
  set(packet "${OUTPUT_DIR}/run-a/packet-${index}.txt")
  file(STRINGS "${packet}" headerLines REGEX "^captureTime_ns ")
  list(GET headerLines 0 timeLine)
  string(REPLACE "captureTime_ns " "" captureTimeToken "${timeLine}")
  # The default encoding mangles the degree sign in the names of the radicals.
  file(STRINGS "${packet}" moleculeLines REGEX "^molecule " ENCODING UTF-8)
  list(LENGTH moleculeLines moleculeCount)
  if(moleculeCount EQUAL 0)
    message(FATAL_ERROR "${packet}: no molecule")
  endif()
  set(groups "")
  set(maxGroup 0)
  foreach(line IN LISTS moleculeLines)
    string(REPLACE " " ";" tokens "${line}")
    list(GET tokens 4 group)
    list(GET tokens 5 occupancyCount)
    math(EXPR timeIndex "12 + ${occupancyCount}")
    list(GET tokens ${timeIndex} globalTime)
    if(NOT globalTime STREQUAL captureTimeToken)
      message(FATAL_ERROR "${packet}: a molecule is at ${globalTime}, not at the capture time ${captureTimeToken}")
    endif()
    if(group GREATER 0)
      list(APPEND groups ${group})
      if(group GREATER maxGroup)
        set(maxGroup ${group})
      endif()
    endif()
  endforeach()
  list(LENGTH groups withGroup)
  if(withGroup GREATER 0)
    set(anyProductGroup ON)
    list(REMOVE_DUPLICATES groups)
    list(LENGTH groups distinctGroups)
    if(NOT distinctGroups EQUAL maxGroup)
      message(FATAL_ERROR "${packet}: product groups are not dense 1..G (${distinctGroups} distinct, largest ${maxGroup})")
    endif()
  endif()
  message(STATUS "packet ${i}: ${moleculeCount} molecules at ${captureTimeToken}, ${withGroup} with a product group (${maxGroup} groups)")
endforeach()

if(EXPECT_BUILD STREQUAL "stock" AND NOT anyProductGroup)
  message(FATAL_ERROR "no molecule carries a product group although start-up reactions fired")
endif()
if(EXPECT_BUILD STREQUAL "patched" AND anyProductGroup)
  message(FATAL_ERROR "a patched capture at chemistry start must not carry product groups")
endif()
