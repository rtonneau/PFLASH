 using namespace std;
 using namespace CLHEP;
 
+#include <map>
+#include <set>
+#include <cmath>
+namespace {
+thread_local std::map<G4int, G4double> sourceActivations;
+
+G4bool IsFreshSource(const G4Track& track)
+{
+  const auto now = G4Scheduler::Instance()->GetGlobalTime();
+  auto found = sourceActivations.find(track.GetTrackID());
+  if(found != sourceActivations.end()) return found->second == now;
+  G4int first=0, second=0;
+  GetIT(const_cast<G4Track*>(&track))->GetParentID(first, second);
+  for(const auto parent : {track.GetParentID(), first, second}) {
+    found = sourceActivations.find(parent);
+    if(parent != 0 && found != sourceActivations.end() && found->second == now) {
+      sourceActivations.emplace(track.GetTrackID(), now);
+      return true;
+    }
+  }
+  return false;
+}
+G4bool IsSourceContact(const G4Track& first, const G4Track& second)
+{
+  if(sourceActivations.empty()) return false;
+  const auto freshFirst=IsFreshSource(first), freshSecond=IsFreshSource(second);
+  if(!freshFirst && !freshSecond) return false;
+  return true;
+}
+}
+void G4DNAIndependentReactionTimeStepper::ResetSourceActivations()
+{
+  sourceActivations.clear();
+
+}
+void G4DNAIndependentReactionTimeStepper::RegisterSourceActivation(G4int trackID, G4double time)
+{
+  if(trackID == 0 || time < 0 || !std::isfinite(time) || !sourceActivations.emplace(trackID,time).second)
+    G4Exception("RegisterSourceActivation", "InvalidSourceActivation", FatalErrorInArgument,
+                "Source identity/time invalid or duplicate");
+}
