+// Experimental: the caller owns source/observation ordering and mesh mutations.
+void G4DNAEventScheduler::ProbeRefresh()
+{
+  fpEventSet->RemoveEventSet();
+  fpGillespieReaction->SetVoxelMesh(*fpMesh);
+  fpUpdateSystem->SetMesh(fpMesh.get());
+  fpGillespieReaction->SetTimeStep(fGlobalTime - fStartTime);
+  fpGillespieReaction->CreateEvents();
+}
+
+void G4DNAEventScheduler::ProbeAdvanceTo(G4double boundary)
+{
+  if(!fInitialized || boundary < fGlobalTime)
+  {
+    G4Exception("G4DNAEventScheduler::ProbeAdvanceTo", "ProbeTimeline", FatalErrorInArgument,
+                "Uninitialized or backwards timeline");
+  }
+  fEndTime = boundary;
+  auto snapshotBulk = []() {
+    std::map<MolType, G4double> counts;
+    auto* bulk = dynamic_cast<G4DNAScavengerMaterial*>(G4Scheduler::Instance()->GetScavengerMaterial());
+    if(bulk != nullptr) for(const auto* conf : bulk->GetScavengerList())
+      counts[conf] = bulk->GetNumberMoleculePerVolumeUnitForMaterialConf(conf);
+    return counts;
+  };
+  while(!fpEventSet->Empty() && (*fpEventSet->begin())->GetTime() + fStartTime < boundary)
+  {
+    const auto before = snapshotBulk();
+    Stepping();
+    fGlobalTime = fStartTime + fTimeStep;
+    // Keep native affected-cell updates unless a shared pool actually changed.
+    if(snapshotBulk() != before) ProbeRefresh();
+  }
+  fGlobalTime = boundary;
+  fTimeStep = boundary - fStartTime;
+}
