# Historical water validation setup: 10 keV electrons and PureWater.
# These commands do not select SBS: they now inherit IRT_syn plus mesoscopic.
# Earlier SBS yields/error estimates belong to validation/reference/sbs_water/README.md;
# they are not guarantees for this macro's current default mode.

/run/verbose 0
/tracking/verbose 0
/dnaLogger/verbose Error

/random/setSeeds 12345 67890
/process/dna/e-SolvationSubType Ritchie1994

# Apply Chemistry/environment PreInit settings before initialization.
/run/initialize
# After /run/initialize: override the Chemistry default end time.
/scheduler/endTime 1 us

/gun/particle e-
/gun/energy 10 keV

/run/beamOn 40
/run/dumpDataAndReset
