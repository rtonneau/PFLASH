# Farokhi2023 proton comparison: 90 MeV, 72.7 uM, IRT_syn without mesoscopic.
# halfBox 5 um gives a water cube of side 10 um for the box-size comparison.
# A smaller world limits the tracked path and chemical population. Escaping
# secondary electrons carry energy out of the box; compare deposited energy
# and track lengths rather than assuming every secondary deposits all its energy.
# Study context and historical measurements: docs/literature-comparison/farokhi2023/.

/run/verbose 0
/tracking/verbose 0
/dnaLogger/verbose Info

/process/dna/e-SolvationSubType Meesungnoen2002

/chem/select Farokhi2023
/chem/meso/enable false
/chem/env/halfBox 5 um

/chem/env/scavenger O2 72.7 uM

# Apply Chemistry/environment PreInit settings before initialization.
/run/initialize

# After /run/initialize: override the Chemistry default end time.
/scheduler/endTime 1 us

/gun/particle proton
/gun/energy 90 MeV

/run/beamOn 20
/run/dumpDataAndReset
