# Demonstrates Tonneau2025 and its Extra molecule HO3, with a 100 ns Hand-over time.

/run/verbose 0
/tracking/verbose 0
/dnaLogger/verbose Info

/process/dna/e-SolvationSubType Ritchie1994

# Select the Tonneau2025 reaction network (Table 2 of Tonneau et al., Phys.
# Med. Biol. 70 (2025) 235021, plus the HO3 molecule). PreInit only: issue it
# before /run/initialize. /chem/list prints the available names.
/chem/select Tonneau2025

# Use a 100 ns Hand-over time for the yield comparison. The hand-over
# occurs on the first step reaching the threshold; Species uses its own record
# grid, so this does not guarantee a Species.Txt sample exactly at 100 ns.
/chem/meso/handOverTime 100 ns

# Apply Chemistry/environment PreInit settings before initialization.
/run/initialize

# After /run/initialize: limit the Mesoscopic stage to 200 ns for this comparison.
/scheduler/endTime 200 ns

/gun/particle e-
/gun/energy 10 keV

/run/beamOn 2
/run/dumpDataAndReset
