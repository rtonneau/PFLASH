# Demonstrates per-event mesoscopic HDF5 snapshots for two 10 keV electron events.

/run/verbose 0
/tracking/verbose 0
/dnaLogger/verbose Info

/process/dna/e-SolvationSubType Ritchie1994

# Write per-event spatial snapshots of the mesoscopic mesh to
# SpeciesMesoSpatial.h5 (default: no spatial output). Use `h5 root` to also
# write SpeciesMesoSpatial.root.
/output/speciesMesoSpatial/format h5

/run/initialize

/gun/particle e-
/gun/energy 10 keV

# After /run/initialize: override the Chemistry default end time.
/scheduler/endTime 1 ms

/run/beamOn 2

/run/dumpDataAndReset
