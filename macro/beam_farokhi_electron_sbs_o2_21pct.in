# Farokhi et al. 2023, Fig. 5: 500 keV electron, SBS time-step model, 21 % O2.
# SBS variant of beam_farokhi_electron_o2_21pct_elossmin_2p5pct.in: forces
# step-by-step chemistry (/process/chem/TimeStepModel SBS, no mesoscopic
# stage) instead of the project default IRT_syn. /primaryKiller/eLossMin
# 12.5 keV truncates the primary after 2.5 % of the 500 keV beam energy.

/run/verbose 0
/tracking/verbose 0
/dnaLogger/verbose Info

/process/dna/e-SolvationSubType Meesungnoen2002

/process/chem/TimeStepModel SBS

/chem/select Farokhi2023
/chem/meso/enable false

/chem/env/scavenger O2 218 uM

/run/initialize

/primaryKiller/eLossMin 12.5 keV
/primaryKiller/verbose 0

/scheduler/endTime 1 us

/gun/particle e-
/gun/energy 500 keV

/run/beamOn 250
/run/dumpDataAndReset
