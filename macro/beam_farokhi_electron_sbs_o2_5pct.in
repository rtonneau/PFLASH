# Farokhi2023 electron comparison: 500 keV, 51.9 uM, SBS without mesoscopic.
# The primary energy-loss threshold is 12.5 keV (2.5 % of initial energy).
# It limits the tracked primary segment; a discrete step can overshoot the threshold.
# Compare actual deposited energy and track lengths in the output.

/run/verbose 0
/tracking/verbose 0
/dnaLogger/verbose Info

/process/dna/e-SolvationSubType Meesungnoen2002

/process/chem/TimeStepModel SBS

/chem/select Farokhi2023
/chem/meso/enable false

/chem/env/scavenger O2 51.9 uM

# Apply Chemistry/environment PreInit settings before initialization.
/run/initialize

/primaryKiller/eLossMin 12.5 keV
/primaryKiller/verbose 0

# After /run/initialize: override the Chemistry default end time.
/scheduler/endTime 1 us

/gun/particle e-
/gun/energy 500 keV

/run/beamOn 250
/run/dumpDataAndReset
