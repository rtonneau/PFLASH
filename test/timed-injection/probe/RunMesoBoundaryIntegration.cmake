foreach(mode IN ITEMS transport dissociation)
 foreach(axis RANGE 0 2)
  foreach(side IN ITEMS -1 1)
   set(observed FALSE)
   foreach(seed RANGE 1729 1792)
    execute_process(COMMAND "${EXE}" "${MACRO}" ${mode} ${axis} ${side} ${seed} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    if(NOT result EQUAL 0 OR NOT output MATCHES "EDGE_PASS")
     message(FATAL_ERROR "${mode} axis=${axis} side=${side} seed=${seed} failed: ${result} ${errors}")
    endif()
    string(REGEX MATCHALL "MODULE [^\r\n]*[\\/]G4[^\\/\r\n]*[.]dll" modules "${output}")
    list(LENGTH modules nmodules)
    if(nmodules LESS 1)
     message(FATAL_ERROR "missing module inventory")
    endif()
    foreach(module IN LISTS modules)
     string(TOLOWER "${module}" normalized)
     string(REPLACE "\\" "/" normalized "${normalized}")
     string(TOLOWER "${PRIVATE_BIN}" expected)
     string(REPLACE "\\" "/" expected "${expected}")
     string(FIND "${normalized}" "${expected}/" found)
     if(found EQUAL -1)
      message(FATAL_ERROR "unexpected module ${module}")
     endif()
    endforeach()
    if(NOT output MATCHES "EDGE_CROSS ([0-9]+) ([0-9]+) ([0-9]+)")
     message(FATAL_ERROR "missing crossing count")
    endif()
    set(transportCount "${CMAKE_MATCH_1}")
    set(dissociationCount "${CMAKE_MATCH_2}")
    set(dissociationCalls "${CMAKE_MATCH_3}")
    if((mode STREQUAL "transport" AND transportCount GREATER 0) OR (mode STREQUAL "dissociation" AND dissociationCalls GREATER 0))
     set(observed TRUE)
     message(STATUS "${mode} axis=${axis} side=${side} action observed seed=${seed} transportCrossings=${transportCount} dissociationCrossings=${dissociationCount} dissociationCalls=${dissociationCalls}")
     break()
    endif()
   endforeach()
   if(NOT observed)
    message(FATAL_ERROR "no ${mode} crossing for axis=${axis} side=${side}")
   endif()
  endforeach()
 endforeach()
endforeach()
