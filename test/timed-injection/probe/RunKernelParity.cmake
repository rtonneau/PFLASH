file(MAKE_DIRECTORY "${OUT}")
foreach(packet RANGE 0 7)
 foreach(rep RANGE 0 1)
  math(EXPR seed "81001+${packet}*101+${rep}*1009")
  foreach(mode RANGE 0 1)
   if(mode EQUAL 0)
    set(program "${INSTALLED}")
   else()
    set(program "${EXE}")
   endif()
   set(base "${OUT}/p${packet}r${rep}m${mode}")
   execute_process(COMMAND "${program}" "${MACRO}" "${LIBRARY}/library${packet}.packet" "${base}.txt" ${seed} 0 0 1 0 2 RESULT_VARIABLE status OUTPUT_FILE "${base}.log" ERROR_FILE "${base}.err" TIMEOUT 120)
   if(NOT status EQUAL 0)
    message(FATAL_ERROR "Baseline history failed: ${base}: ${status}")
   endif()
  endforeach()
 endforeach()
endforeach()
if(DEFINED COMPARE)
 execute_process(COMMAND "${COMPARE}" "${OUT}" RESULT_VARIABLE status)
 if(NOT status EQUAL 0)
  message(FATAL_ERROR "Installed/copied kernel statistical equivalence failed (${status}); see ${OUT}/comparison.txt")
 endif()
endif()
