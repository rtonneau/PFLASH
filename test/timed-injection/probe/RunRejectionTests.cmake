execute_process(COMMAND "${MUTATE}" "${OUT}/library0.packet" "${OUT}/invalid" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "Could not prepare invalid packets")
endif()
foreach(i RANGE 0 3)
 execute_process(COMMAND "${EXE}" "${MACRO}" import "${OUT}/invalid${i}" 1 2 3 RESULT_VARIABLE result OUTPUT_FILE "${OUT}/invalid${i}.log" ERROR_FILE "${OUT}/invalid${i}.err" TIMEOUT 45)
 file(READ "${OUT}/invalid${i}.err" error)
 if(NOT result EQUAL 2 OR NOT error MATCHES "PACKET_ERROR")
  message(FATAL_ERROR "Invalid packet ${i} was not cleanly rejected: ${result}")
 endif()
endforeach()
file(READ "${MACRO}" macro)
# Inject real PrimaryKiller truncation and abortion, not synthetic packet flags.
foreach(kind truncated aborted)
 if(kind STREQUAL "truncated")
  set(cuts "/primaryKiller/energyCuts true\n/primaryKiller/eLossMin 1 eV\n")
 else()
  set(cuts "/primaryKiller/energyCuts true\n/primaryKiller/eLossMax 1 eV\n")
 endif()
 file(WRITE "${OUT}/${kind}.in" "${macro}\n${cuts}")
 execute_process(COMMAND "${EXE}" "${OUT}/${kind}.in" capture "${OUT}/${kind}" 10001 20001 3 RESULT_VARIABLE result OUTPUT_FILE "${OUT}/${kind}.log" ERROR_FILE "${OUT}/${kind}.err" TIMEOUT 45)
 file(READ "${OUT}/${kind}.err" error)
 if(NOT result EQUAL 2 OR NOT error MATCHES "PACKET_ERROR.*(truncated|aborted|killed)")
  message(FATAL_ERROR "${kind} event was not cleanly rejected: ${result}: ${error}")
 endif()
endforeach()
