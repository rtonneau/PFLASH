foreach(seed RANGE 1729 1760)
 foreach(mode IN ITEMS native hook)
  execute_process(COMMAND "${EXE}" "${MACRO}" ${mode} ${seed} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
  if(NOT result EQUAL 0 OR NOT output MATCHES "QUEUE_CONTROL_COMPLETE")
   message(FATAL_ERROR "${mode} ${seed} failed: ${result}: ${errors}")
  endif()
  string(REGEX MATCHALL "MODULE [^\r\n]*[\\/]G4[^\\/\r\n]*[.]dll" modules "${output}")
  list(LENGTH modules moduleCount)
  if(moduleCount LESS 1)
   message(FATAL_ERROR "${mode} ${seed}: no Geant4 module inventory")
  endif()
  foreach(module IN LISTS modules)
   string(TOLOWER "${module}" normalized)
   string(REPLACE "\\" "/" normalized "${normalized}")
   string(TOLOWER "${PRIVATE_BIN}" expected)
   string(REPLACE "\\" "/" expected "${expected}")
   string(FIND "${normalized}" "${expected}/" found)
   if(found EQUAL -1)
    message(FATAL_ERROR "${mode} ${seed}: unexpected module ${module}")
   endif()
  endforeach()
  string(REGEX MATCHALL "CELL [^\r\n]*" cells_${mode} "${output}")
  list(SORT cells_${mode})
 endforeach()
 if(NOT "${cells_native}" STREQUAL "${cells_hook}")
  message(FATAL_ERROR "seed ${seed}: native/hook cell populations differ: ${cells_native} vs ${cells_hook}")
 endif()
endforeach()
message(STATUS "Native/hook queue parity passed 32 seeds, unchanged bulk, private DLLs")
