file(MAKE_DIRECTORY "${OUT}")
foreach(mode RANGE 0 2)
 if(mode EQUAL 2)
  set(delay 1.5)
  set(label 0)
 else()
  set(delay 0)
  set(label ${mode})
 endif()
 execute_process(COMMAND "${EXE}" "${MACRO}" "${LIBRARY}/library0.packet" "${LIBRARY}/holdout0.packet" "${OUT}/${mode}.txt" 91001 ${label} ${delay} RESULT_VARIABLE result OUTPUT_FILE "${OUT}/${mode}.log" ERROR_FILE "${OUT}/${mode}.err" TIMEOUT 180)
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "Combined history ${mode} failed: ${result}")
 endif()
endforeach()
foreach(mode RANGE 0 1)
 file(STRINGS "${OUT}/${mode}.txt" budget REGEX "^(energy_MeV|mass_kg|source_count|registrations|dose_Gy) ")
 if(mode EQUAL 0)
  set(reference "${budget}")
 elseif(NOT "${budget}" STREQUAL "${reference}")
  message(FATAL_ERROR "Combined source budgets differ")
 endif()
endforeach()
