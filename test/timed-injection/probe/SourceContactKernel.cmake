# Read-only source copies with distinct model symbols; no shared files are modified.
if(DEFINED PROBE_G4_SOURCE)
 set(localKernel "${CMAKE_BINARY_DIR}/source-contact-kernel")
 file(MAKE_DIRECTORY "${localKernel}")
 if(WIN32)
  # MSVC cannot import these TLS slots directly. Preserve the DLL-owned reaction set.
  foreach(header G4ITReaction G4VITTimeStepComputer)
   file(READ "${PROBE_G4_SOURCE}/source/processes/electromagnetic/dna/management/include/${header}.hh" abi)
   if(header STREQUAL "G4ITReaction")
    # Call the exported accessor inside the DLL instead of referencing its TLS slot.
    string(REGEX REPLACE "static G4ITReactionSet\\* Instance\\(\\)[ \n]*\\{[^}]*\\}" "static G4ITReactionSet* Instance();" abi "${abi}")
   endif()
   file(WRITE "${localKernel}/${header}.hh" "${abi}")
  endforeach()
 endif()
 set(kernelNames G4DNAIndependentReactionTimeStepper G4DNAIndependentReactionTimeModel G4DNAMakeReaction)
 foreach(name IN LISTS kernelNames)
  foreach(ext cc hh)
   if(ext STREQUAL "cc")
    set(part src)
   else()
    set(part include)
   endif()
   file(READ "${PROBE_G4_SOURCE}/source/processes/electromagnetic/dna/models/${part}/${name}.${ext}" kernel)
   foreach(rename IN LISTS kernelNames)
    string(REPLACE "${rename}" "Probe${rename}" kernel "${kernel}")
   endforeach()
   if(name STREQUAL "G4DNAIndependentReactionTimeStepper" AND ext STREQUAL "cc")
    set(needle "G4Scheduler::Instance()->GetGlobalTime() == G4Scheduler::Instance()->GetStartTime()")
    string(FIND "${kernel}" "${needle}" found)
    if(found EQUAL -1)
     message(FATAL_ERROR "Source contact patch boundary missing")
    endif()
    string(REPLACE "${needle}" "SourceContacts::AtContact(trackA, *pTrackB)" kernel "${kernel}")
    string(REPLACE "fUserMinTimeStep = 1 * CLHEP::ps;" "G4VITTimeStepComputer::SetTimes(G4Scheduler::Instance()->GetGlobalTime(), 1 * CLHEP::ps);" kernel "${kernel}")
    string(REPLACE "fUserMinTimeStep" "SourceContacts::unusedMinTimeStep" kernel "${kernel}")
    string(PREPEND kernel "#include \"SourceContacts.hh\"\n")
   endif()
   file(WRITE "${localKernel}/Probe${name}.${ext}" "${kernel}")
  endforeach()
 endforeach()
 file(READ "${root}/src/chemistry/DnaChemistryList.cc" chemistry)
 string(REPLACE "G4DNAIndependentReactionTimeModel" "ProbeG4DNAIndependentReactionTimeModel" chemistry "${chemistry}")
 file(WRITE "${localKernel}/DnaChemistryList.cc" "${chemistry}")
 set(candidateSources ${injectionSources})
 list(FILTER candidateSources EXCLUDE REGEX "/DnaChemistryList[.]cc$")
 file(GLOB kernelSources "${localKernel}/*.cc")
 add_executable(InjectionContactCandidate InjectionReference.cc ${candidateSources} ${kernelSources})
 target_include_directories(InjectionContactCandidate PRIVATE "${root}/header" "${localKernel}" "${CMAKE_CURRENT_SOURCE_DIR}")
 target_compile_definitions(InjectionContactCandidate PRIVATE DNACHEM_HAS_HDF5=0)
 target_link_libraries(InjectionContactCandidate PRIVATE ${Geant4_LIBRARIES})
 foreach(fixture simultaneous shifted delayed nonreacting)
  add_test(NAME SourceContactCandidate_${fixture} COMMAND InjectionContactCandidate "${CMAKE_CURRENT_SOURCE_DIR}/Capture.in" ${fixture} 1729 patched)
  set_tests_properties(SourceContactCandidate_${fixture} PROPERTIES LABELS injection-candidate TIMEOUT 60)
 endforeach()
endif()

if(TARGET InjectionContactCandidate)
 get_target_property(historySources InjectionContactCandidate SOURCES)
 list(FILTER historySources EXCLUDE REGEX "InjectionReference[.]cc$")
 add_executable(PacketHistory PacketHistory.cc ${historySources})
 target_include_directories(PacketHistory PRIVATE "${root}/header" "${localKernel}" "${CMAKE_CURRENT_SOURCE_DIR}")
 target_compile_definitions(PacketHistory PRIVATE DNACHEM_HAS_HDF5=0 PACKET_COMPATIBILITY="${fingerprint}")
 target_link_libraries(PacketHistory PRIVATE PacketData ${Geant4_LIBRARIES})
endif()

if(WIN32 AND TARGET InjectionContactCandidate)
 target_compile_options(InjectionContactCandidate PRIVATE "/FI${localKernel}/G4ITReaction.hh")
 target_compile_options(PacketHistory PRIVATE "/FI${localKernel}/G4ITReaction.hh")
endif()

if(TARGET InjectionContactCandidate)
 get_target_property(finderSources InjectionContactCandidate SOURCES)
 list(FILTER finderSources EXCLUDE REGEX "InjectionReference[.]cc$")
 add_executable(FinderFixtureAdapter FinderFixture.cc ${finderSources})
 target_include_directories(FinderFixtureAdapter PRIVATE "${root}/header" "${localKernel}" "${CMAKE_CURRENT_SOURCE_DIR}")
 target_compile_definitions(FinderFixtureAdapter PRIVATE DNACHEM_HAS_HDF5=0)
 target_link_libraries(FinderFixtureAdapter PRIVATE ${Geant4_LIBRARIES})
 if(WIN32)
  target_compile_options(FinderFixtureAdapter PRIVATE "/FI${localKernel}/G4ITReaction.hh")
 endif()
endif()





