file(MAKE_DIRECTORY "${OUT}")
foreach(packet RANGE 0 7)
 foreach(rep RANGE 0 1)
  math(EXPR seed "71001+${packet}*101+${rep}*1009")
  foreach(patched RANGE 0 1)
   set(base "${OUT}/p${packet}r${rep}m${patched}")
   execute_process(COMMAND "${EXE}" "${MACRO}" "${LIBRARY}/library${packet}.packet" "${base}.txt" ${seed} ${patched} 0 1 1 RESULT_VARIABLE status OUTPUT_FILE "${base}.log" ERROR_FILE "${base}.err" TIMEOUT 120)
   if(NOT status EQUAL 0)
    message(FATAL_ERROR "History failed: ${base}: ${status}")
   endif()
  endforeach()
 endforeach()
endforeach()
