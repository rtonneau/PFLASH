# Every worker owns whole histories. Compare source schedules/budgets, not paths.
file(MAKE_DIRECTORY "${OUT}/serial" "${OUT}/mt")
set(extra)
if(DEFINED LIBRARY AND NOT LIBRARY STREQUAL "")
  list(APPEND extra "${LIBRARY}")
  set(lastEvent 1)
else()
  set(lastEvent 7)
endif()
foreach(mode serial mt)
  if(mode STREQUAL "serial")
    set(workers 0)
  else()
    set(workers 2)
  endif()
  execute_process(COMMAND "${EXE}" "${MACRO}" "${OUT}/${mode}" ${workers} ${extra}
    RESULT_VARIABLE result OUTPUT_FILE "${OUT}/${mode}/stdout.log"
    ERROR_FILE "${OUT}/${mode}/stderr.log" TIMEOUT 1200)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${mode} complete histories failed: ${result}")
  endif()
endforeach()
foreach(run RANGE 0 1)
  foreach(event RANGE 0 ${lastEvent})
    foreach(mode serial mt)
      file(READ "${OUT}/${mode}/run${run}event${event}.txt" content)
      if(NOT content MATCHES "COMPLETE_HISTORY_PASS")
        message(FATAL_ERROR "Missing complete history: ${mode}/${run}/${event}")
      endif()
      # Reactions and surviving species are stochastic. Source rows are exact.
      string(REGEX MATCHALL "(^|\n)(run|event|registered|offset_ps|seed|packets|source_count|energy_MeV|dose_Gy|arrival) [^\n]*" sourceRows "${content}")
      set(${mode}Source "${sourceRows}")
    endforeach()
    if(NOT serialSource STREQUAL mtSource)
      message(FATAL_ERROR "Worker scheduling changed source ${run}/${event}")
    endif()
  endforeach()
endforeach()
message(STATUS "Complete history source budgets agree between Serial and MT")
