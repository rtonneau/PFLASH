file(MAKE_DIRECTORY "${OUT}")
foreach(group library holdout)
 foreach(i RANGE 0 7)
  if(group STREQUAL "library")
   math(EXPR physics "10001+${i}*101")
   math(EXPR source "20001+${i}*103")
   set(mode direct)
  else()
   math(EXPR physics "30001+${i}*107")
   math(EXPR source "40001+${i}*109")
   set(mode capture)
  endif()
  math(EXPR chemistry "50001+${i}*113")
  set(base "${OUT}/${group}${i}")
  file(REMOVE "${base}.packet" "${base}.chemistry" "${base}.roundtrip" "${base}.energy")
  execute_process(COMMAND "${EXE}" "${MACRO}" ${mode} "${base}" ${physics} ${source} ${chemistry} RESULT_VARIABLE result OUTPUT_FILE "${base}.log" ERROR_FILE "${base}.err" TIMEOUT 120)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "${base} generation failed: ${result}")
  endif()
  if(group STREQUAL "library")
   file(COPY_FILE "${base}.chemistry" "${base}.direct")
   execute_process(COMMAND "${EXE}" "${MACRO}" import "${base}" 991 992 ${chemistry} RESULT_VARIABLE result OUTPUT_FILE "${base}.import.log" ERROR_FILE "${base}.import.err" TIMEOUT 120)
   if(NOT result EQUAL 0)
    message(FATAL_ERROR "${base} import failed: ${result}")
   endif()
   file(SHA256 "${base}.packet" before)
   file(SHA256 "${base}.roundtrip" after)
   if(NOT before STREQUAL after)
    message(FATAL_ERROR "Bit-exact file roundtrip failed")
   endif()
  endif()
 endforeach()
endforeach()
# Repeated direct control reports stochastic/order variability independently of import.
execute_process(COMMAND "${EXE}" "${MACRO}" direct "${OUT}/repeat" 10001 20001 50001 RESULT_VARIABLE result OUTPUT_FILE "${OUT}/repeat.log" ERROR_FILE "${OUT}/repeat.err" TIMEOUT 120)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "Repeated direct control failed")
endif()
execute_process(COMMAND "${COMPARE}" "${OUT}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "library comparison failed: ${result}")
endif()


