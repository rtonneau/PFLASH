file(MAKE_DIRECTORY "${ARTIFACTS}")
function(run_probe name mode)
  file(MAKE_DIRECTORY "${ARTIFACTS}/${name}")
  execute_process(COMMAND "${PROBE}" "${MACRO}" "${ARTIFACTS}/${name}" "${mode}" "${WORKERS}" "${EVENTS}"
    RESULT_VARIABLE result OUTPUT_FILE "${ARTIFACTS}/${name}.log" ERROR_FILE "${ARTIFACTS}/${name}.err" TIMEOUT 75)
  if(NOT result STREQUAL "0")
    message(FATAL_ERROR "${name} process failed: ${result}; see ${ARTIFACTS}/${name}.log and .err")
  endif()
  file(READ "${ARTIFACTS}/${name}.log" log)
  if(NOT log MATCHES "PROBE_PROCESS_DONE events=${EVENTS}" OR log MATCHES "EEEE|FatalException")
    message(FATAL_ERROR "${name} did not finish cleanly; see ${ARTIFACTS}/${name}.log")
  endif()
endfunction()
if(MODE STREQUAL "oracle")
  run_probe(reference-a oracle)
  run_probe(reference-b oracle)
  execute_process(COMMAND "${COMPARE}" oracle "${ARTIFACTS}/reference-a" "${ARTIFACTS}/reference-b" "${EVENTS}"
    RESULT_VARIABLE comparison OUTPUT_VARIABLE report ERROR_VARIABLE errors)
else()
  run_probe(candidate ${MODE})
  execute_process(COMMAND "${COMPARE}" capture "${ARTIFACTS}/candidate" unused "${EVENTS}"
    RESULT_VARIABLE comparison OUTPUT_VARIABLE report ERROR_VARIABLE errors)
endif()
file(WRITE "${ARTIFACTS}/comparison.txt" "${report}${errors}")
message("${report}${errors}")
if(NOT comparison STREQUAL "0")
  message(FATAL_ERROR "NO-GO (${MODE}): ${ARTIFACTS}/comparison.txt. Observation files are NOT checkpoints; no fresh-process restore was attempted from invalid state.")
endif()
